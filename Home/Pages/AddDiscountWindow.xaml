<Window x:Class="Home.Pages.AddDiscountWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить акицю" Height="250" Width="800" Background="#1A1A1A"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MainPanel" Margin="10" Background="#222" Orientation="Vertical" >

            <!-- Кнопка [+] -->
            <Button Content="+" Click="AddItemBlock_Click"
                    Width="40" Height="30"
                    Background="#2ecc71" Foreground="White"
                    FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" />

            <!-- Контейнер для всех блоков -->
            <StackPanel x:Name="ItemsPanel" Orientation="Vertical" />

            <!-- Кнопка "Добавить" -->
            <Button Content="Добавить"
                    Click="SaveToDatabase_Click"
                    Width="150" Height="35"
                    Background="#3498db" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
