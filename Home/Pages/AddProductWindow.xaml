<Window x:Class="Home.Pages.AddProductWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить товар" Height="250" Width="800" Background="#1A1A1A"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,23,0,0" Width="760">
            <StackPanel>
                <TextBlock Text="Наименование" Foreground="White"/>
                <TextBox x:Name="NameTextBox" Width="120"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Ед. изм." Foreground="White"/>
                <ComboBox x:Name="UnitComboBox" Width="80">
                    <ComboBoxItem Content="шт."/>
                    <ComboBoxItem Content="кг."/>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Кол-во" Foreground="White"/>
                <TextBox x:Name="QuantityTextBox" Width="60"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Цена закупки" Foreground="White"/>
                <TextBox x:Name="PurchasePriceTextBox" Width="80" TextChanged="UpdatePrice"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Наценка (%)" Foreground="White"/>
                <TextBox x:Name="MarkupTextBox" Width="80" TextChanged="UpdatePrice"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Цена продажи" Foreground="White"/>
                <TextBlock x:Name="SellingPriceTextBlock" Width="100" Background="#333" Foreground="White" Text="0" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Button Content="Добавить" Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="10,5"
                Background="Transparent" BorderBrush="LimeGreen" BorderThickness="2" Foreground="White"/>
    </Grid>
</Window>
