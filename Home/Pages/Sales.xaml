<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:Home.Converters"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Home.Pages.Sales"
      Background="#1A1A1A" av:DesignHeight="690" av:DesignWidth="924">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
           <Setter Property="RowBackground" Value="White"/>
<Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444"/>
            <Setter Property="VerticalGridLinesBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#292929"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="BorderBrush" Value="#3A3A3A"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="387*"/>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="476*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Блок с таблицей -->
        <DataGrid x:Name="SaleGrid" Grid.Row="0" Grid.Column="0"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="White"
                  Foreground="Black" Grid.ColumnSpan="3" Margin="0,0,257,143" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="*"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="Auto"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="Auto"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="Auto"/>
                <DataGridTextColumn Header="Ед. Изм." Binding="{Binding Unit}" Width="Auto"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="Auto"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Блок с полями -->
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="245,0,0,0" VerticalAlignment="Bottom" Grid.Column="2" Grid.RowSpan="2" Height="640" Width="223">
                <TextBlock Text="Чек № 123456789" FontSize="18" Foreground="White" Margin="0,0,0,0" Height="26"/>

            <StackPanel  Height="49">
                <TextBlock  Text="Cумма" HorizontalAlignment="Center"   Foreground="White"/>
                <TextBox x:Name="TotalSumTextBlock" Width="200"/>
            </StackPanel>
            <StackPanel  Height="52">
                <TextBlock Text="Получено" HorizontalAlignment="Center" Foreground="White"/>
                <TextBox Width="200"/>
            </StackPanel>
            <StackPanel  Height="56">
                <TextBlock Text="Скидка" HorizontalAlignment="Center" Foreground="White"/>
                <TextBox Width="200"/>
            </StackPanel>
            <StackPanel  Height="53">
                <TextBlock Text="Сдача" HorizontalAlignment="Center" Foreground="White"/>
                <TextBox Width="200"/>
            </StackPanel>
            <StackPanel  Margin="0,300,0,0" Height="78" Orientation="Horizontal" Width="231" >
                <Button Content="Наличные"  Width="100" Height="50" Margin="10"/>
                <Button Content="Отмена"  Width="100" Height="50" Margin="10"/>
            </StackPanel>
        </StackPanel>
        <!-- Блок "Чек" с кнопками -->
        <TextBlock Text="Чек" Foreground="White" FontSize="20" Margin="19,136,465,79" Width="400" Grid.ColumnSpan="3" Grid.Row="1"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="92" Width="454">
            <UniformGrid Columns="3" Rows="2" Height="70" Width="460">
                <Button Click="ClearButton_Click" Content="Очистить"  Width="110" Height="25"/>
                <Button Content="Отложить"  Width="110" Height="25"/>
                <Button Content="Аннулировать"  Width="110" Height="25"/>
                <Button Content="Открыть"  Width="110" Height="25"/>
                <Button Content="Акции"  Width="110" Height="25"/>
                <Button Content="Штрих код"  Width="110" Height="25" Click="BarcodeButton_Click"/>
            </UniformGrid>

        </StackPanel>


    </Grid>
</Page>
