<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:Home.Converters"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Home.Pages.Sales"
      Background="#1A1A1A" av:DesignHeight="690" av:DesignWidth="924">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444"/>
            <Setter Property="VerticalGridLinesBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0,0,0.5,0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,0.5,0"/>
        </Style>
    </Page.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="387*"/>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="476*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Блок с таблицей -->
        <DataGrid x:Name="SaleGrid" Grid.Row="0"  IsReadOnly="True" Grid.Column="0"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="White"
                  Foreground="Black" Grid.ColumnSpan="3" Margin="0,0,257,143" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="40"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Ед. Изм." Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="70"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}" Width="70"/>
                <DataGridTemplateColumn Header="" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑" 
                                    Background="Red" 
                                    Foreground="White" 
                                    Width="30" Height="30"
                                    Click="DeleteRowButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Блок с полями -->
        <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="0,40,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Сумма:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,10" Grid.Row="0" Grid.Column="0"/>
            <Border Grid.Row="0" Grid.Column="1" Height="32" Margin="8,0,0,10" Background="#232323" BorderBrush="#444" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                <TextBlock x:Name="TotalSumTextBlock" Text="0" Foreground="White" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <TextBlock Text="Получено:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,10" Grid.Row="1" Grid.Column="0"/>
            <Border Grid.Row="1" Grid.Column="1" Height="32" Margin="8,0,0,10" Background="#232323" BorderBrush="#444" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                <TextBox x:Name="PaymentTextBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="PaymentTextBox_TextChanged"/>
            </Border>

            <TextBlock Text="Скидка:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,10" Grid.Row="2" Grid.Column="0"/>
            <Border Grid.Row="2" Grid.Column="1" Height="32" Margin="8,0,0,10" Background="#232323" BorderBrush="#444" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                <TextBox x:Name="DiscountTextBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            </Border>

            <TextBlock Text="Сдача:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" Grid.Column="0"/>
            <Border Grid.Row="3" Grid.Column="1" Height="32" Margin="8,0,0,0" Background="#232323" BorderBrush="#444" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                <TextBlock x:Name="ChangeTextBlock" Text="0" Foreground="White" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        <!-- Блок "Чек" с кнопками -->
        <TextBlock Text="Чек" Foreground="White" FontSize="20" Margin="19,136,465,79" Width="400" Grid.ColumnSpan="3" Grid.Row="1"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="92" Width="454">
            <UniformGrid Columns="3" Rows="2" Height="70" Width="460">
                <Button Click="ClearButton_Click" Content="Очистить"  Width="110" Height="25"/>
                <Button Content="Отложить"  Width="110" Height="25"/>
                <Button Content="Аннулировать"  Width="110" Height="25"/>
                <Button Content="Открыть"  Width="110" Height="25"/>
                <Button Content="Акции"  Width="110" Height="25"/>
                <Button Content="Добавить"  Width="110" Height="25" Click="BarcodeButton_Click"/>
            </UniformGrid>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="92" Margin="0,0,20,0">
            <Button Content="Наличные&#x0a;[F5]"
                    Width="120" Height="60"
                    Margin="0,0,20,0"
                    FontSize="20"
                    FontWeight="Bold"
                    Background="#232323"
                    Foreground="White"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand"/>
            <Button Content="Платежная&#x0a;карта [F6]"
                    Width="120" Height="60"
                    FontSize="20"
                    FontWeight="Bold"
                    Background="#232323"
                    Foreground="White"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>
