<Page x:Class="Home.Pages.Storage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:Home.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      Title="WarehousePage">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="#1A1A1A" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Top" HorizontalAlignment="Left" >
            <!-- Меню "Вид" -->
            <ComboBox Width="150" Height="28" Margin="0,0,10,0">
                <ComboBoxItem Content="Все товары" />
                <ComboBoxItem Content="Товары на складе" />
                <ComboBoxItem Content="Недоступные товары" />
            </ComboBox>

            <!-- Кнопка "Добавить" -->
            <Button Content="Добавить"
                    Width="100"
                    Height="28"
                    BorderBrush="Green"
                    Foreground="White"
                    BorderThickness="2"
                    Background="Transparent"
                    Margin="0,0,10,0" Click="AddButton_Click"/>

            <!-- Меню "Группировка" -->
            <ComboBox Width="150" Height="28" Margin="0,0,10,0">
                <ComboBoxItem Content="По категориям" />
                <ComboBoxItem Content="По алфавиту" />
                <ComboBoxItem Content="По количеству" />
            </ComboBox>

            <!-- Поле поиска -->
            <Grid Width="200" Height="28" Margin="0,0,0,0">
                <TextBox x:Name="SearchBox"
                         VerticalContentAlignment="Center"
                         Background="White"
                         Foreground="Black"
                         BorderBrush="Gray"
                         BorderThickness="1"
                         Padding="5"/>
                <TextBlock Text="Поиск..."
                           Foreground="Gray"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>

        <!-- Таблица товаров -->
        <DataGrid x:Name="myDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="White"
                  Foreground="Black"
                  HorizontalGridLinesBrush="LightGray"
                  VerticalGridLinesBrush="LightGray"
                  RowBackground="White"
                  AlternatingRowBackground="#F0F0F0"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
