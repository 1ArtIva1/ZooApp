<Page x:Class="Home.Pages.Storage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:Home.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      Title="WarehousePage">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#2A2A2A"/>
            <Setter Property="AlternatingRowBackground" Value="#333333"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444"/>
            <Setter Property="VerticalGridLinesBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#292929"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="BorderBrush" Value="#3A3A3A"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#1A1A1A" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Top" HorizontalAlignment="Left" >
            <!-- Меню "Вид" -->
            <ComboBox x:Name="ViewComboBox"
          Width="150" Height="28" Margin="0,0,10,0"
          SelectionChanged="ViewComboBox_SelectionChanged">
                <ComboBoxItem Content="Все товары" />
                <ComboBoxItem Content="Товары на складе" />
                <ComboBoxItem Content="Недоступные товары" />
            </ComboBox>

            <!-- Кнопка "Добавить" -->
            <Button Content="Добавить"
                Width="100"
                Height="28"
                BorderBrush="Green"
                Foreground="White"
                BorderThickness="2"
                Background="Transparent"
                Margin="0,0,10,0"
                Click="AddButton_Click"/>

            <!-- Меню "Группировка" -->
            <ComboBox x:Name="SortComboBox"
                Width="150" Height="28" Margin="0,0,10,0"
                SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="По категориям" />
                <ComboBoxItem Content="По алфавиту" />
                <ComboBoxItem Content="По количеству" />
            </ComboBox>

            <!-- Поле поиска -->
            <Grid Width="200" Height="28" Margin="0,0,0,0">
                <TextBox x:Name="SearchBox"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         Background="White"
                         Foreground="Black"
                         BorderBrush="Gray"
                         BorderThickness="1"
                         Padding="5"/>
                <TextBlock Text="Поиск..."
                           Foreground="Gray"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>

        <!-- Таблица товаров -->
        <DataGrid x:Name="myDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="White"
                  Foreground="Black"
                  HorizontalGridLinesBrush="LightGray"
                  VerticalGridLinesBrush="LightGray"
                  RowBackground="White"
                  AlternatingRowBackground="#F0F0F0"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
