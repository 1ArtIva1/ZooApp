<Page x:Class="Home.Pages.Operations"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Home.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Operations"
      Background="#1A1A1A">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Top">
            <Button Content="Возврат чека" Margin="0,0,10,0" Padding="10,2"/>
            <TextBlock Text="Группировка:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="GroupComboBox" Width="120" Height="28" SelectedIndex="0">
                <ComboBoxItem Content="Продавцы"/>
                <ComboBoxItem Content="Даты"/>
                <ComboBoxItem Content="Тип операции"/>
            </ComboBox>
        </StackPanel>

        <!-- Таблица -->
        <Border Grid.Row="1" Margin="5,0,5,5" BorderBrush="#333" BorderThickness="1" CornerRadius="3">
            <DataGrid x:Name="OperationsDataGrid"
                      AutoGenerateColumns="False"
                      Background="#1A1A1A"
                      Foreground="Black"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="#232323"
                      AlternatingRowBackground="#1A1A1A"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/>
                    <DataGridTextColumn Header="Тип операции" Binding="{Binding OperationType}" Width="150"/>
                    <DataGridTextColumn Header="Продавец" Binding="{Binding Seller}" Width="150"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
