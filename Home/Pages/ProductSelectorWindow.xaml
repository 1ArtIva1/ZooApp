<Window x:Class="Home.Pages.ProductSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Home.Pages"
        mc:Ignorable="d"
        Title="Выбор товара" Height="450" Width="800"
        Background="#1A1A1A"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444"/>
            <Setter Property="VerticalGridLinesBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#292929"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="BorderBrush" Value="#3A3A3A"/>
                        <Setter Property="BorderThickness" Value="0,0,0.5,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0,0,0.5,0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
    </Window.Resources>
    <Grid>
        <StackPanel Margin="10">
            <TextBox x:Name="SearchBox"
                     Width="200"
                     TextChanged="SearchBox_TextChanged"
                     />
            <ComboBox x:Name="SortComboBox" Width="200"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По алфавиту"/>
                <ComboBoxItem Content="По категории"/>
                <ComboBoxItem Content="По количеству"/>
            </ComboBox>
            <DataGrid x:Name="ProductDataGrid" AutoGenerateColumns="False" Height="300" MouseDoubleClick="ProductGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
