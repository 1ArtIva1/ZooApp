<Page x:Class="Home.Pages.Adminstration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Home.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Adminstration">

    <Grid>
        <VirtualizingStackPanel x:Name="MainPanel" Background="#1A1A1A" Margin="0,0,0,0">
            
            <VirtualizingStackPanel.Resources>
                <Style TargetType="Button" x:Key="MenuButtonStyle">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="FontSize" Value="18"/>
                </Style>
            </VirtualizingStackPanel.Resources>
            <StackPanel Margin="20" Grid.ColumnSpan="4">
                <Button Style="{StaticResource MenuButtonStyle}" Click="UsersButton_Click" Margin="0,0,2,20">
                    Пользователи
                </Button>
                <Button Style="{StaticResource MenuButtonStyle}" Click="DiscountsButton_Click">
                    Акции
                </Button>
            </StackPanel>
        </VirtualizingStackPanel>
    </Grid>
</Page>
