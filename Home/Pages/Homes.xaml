<Page x:Class="Home.Pages.Homes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1A1A1A">
    <Page.Resources>
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="50"/> <!-- увеличен шрифт -->
        </Style>
    </Page.Resources>
    <Grid>
        <!-- Кнопка "Начать смену" -->
        <Button x:Name="StartShiftButton"
                Content="Начать смену"
                Width="200"
                Height="50"
                FontSize="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="StartShiftButton_Click"/>
        
        <!-- Основное содержимое, скрыто до начала смены -->
        <Grid x:Name="MainContentPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Основное содержимое -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="18*"/>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="816*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="32" Grid.ColumnSpan="4">
                    <!-- Блок с аватаром и ФИО -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="80" Height="80" Fill="White" Grid.Column="0" Margin="0,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Иванов Артём Алексеевич" FontSize="22" Foreground="White"/>
                                <TextBlock Text="Продавец-консультант" FontSize="16" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Линия-разделитель -->
                    <Border Height="1" Background="#222" Margin="0,0,0,24"/>

                    <!-- Блок с выручкой -->
                    <TextBlock Text="Общая выручка за смену:" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Наличные" Foreground="White" FontSize="18"/>
                        <TextBlock Text="Наличные: 2210 руб." FontSize="16" Foreground="#CCCCCC"/>
                        <TextBlock Text="Безналичная оплата" Foreground="White" FontSize="18"/>
                        <TextBlock Text="Безналичная оплата: 0 руб." FontSize="16" Foreground="#CCCCCC"/>
                        <TextBlock Text="Средний чек: 2210" FontSize="16" Foreground="#CCCCCC"/>
                        <TextBlock Text="Оформленные чеки: 1" FontSize="16" Foreground="#CCCCCC"/>
                    </StackPanel>

                    <!-- Линия-разделитель -->
                    <Border Height="1" Background="#222" Margin="0,24,0,24"/>

                    <!-- Блок с временем работы -->
                    <TextBlock Text="Время работы:" FontSize="24" FontWeight="Bold" Foreground="White"/>
                         <!--Время начала смены-->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Начало смены: " FontSize="16" Foreground="#CCCCCC"/>
                        <TextBlock x:Name="ShiftStartTimeTextBlock" FontSize="16" Foreground="#CCCCCC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Время работы: " FontSize="16" Foreground="#CCCCCC"/>
                        <TextBlock x:Name="WorkDurationTextBlock" FontSize="16" Foreground="#CCCCCC"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Часы -->
            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:HH:mm}'}"
                       xmlns:sys="clr-namespace:System;assembly=mscorlib"
                       x:Name="ClockTextBlock"
                       FontSize="96"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,20,20"/>
            <Calendar Margin="0,20,40,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top">
                <Calendar.LayoutTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                </Calendar.LayoutTransform>
            </Calendar>
        </Grid>
    </Grid>
</Page>
