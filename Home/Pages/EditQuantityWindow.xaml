<Window x:Class="Home.Pages.EditQuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать количество" Height="180" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ProductNameTextBlock"
                   Text="Товар"
                   Foreground="White"
                   FontSize="16"
                   Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Новое количество:" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <TextBox x:Name="QuantityTextBox" Width="80" Height="28" Margin="10,0,0,0" FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="ОК" Width="80" Margin="0,0,10,0" Click="OkButton_Click"
                    Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Content="Отмена" Width="80" Click="CancelButton_Click"
                    Background="#444" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
