<Window x:Class="Home.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Home.Converters"
        mc:Ignorable="d"
        Title="Program for smthng (ver. 0.1.2)"
        Height="800" Width="1200"
        Background="#1A1A1A"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- Стиль для TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="3,3,0,0"
                                BorderThickness="0" 
                                >
                            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                                <ContentPresenter x:Name="ContentSite" 
                                                  VerticalAlignment="Center" 
                                                  ContentSource="Header" 
                                                  Margin="6,0,0,0" 
                                                  RecognizesAccessKey="True"/>
                                <Button x:Name="PART_Close"
                                    Content="✕"
                                    Width="16"
                                    Height="16"
                                    Margin="5,0,0,0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Background="Transparent"
                                    Foreground="White"
                                    BorderBrush="{x:Null}"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Click="CloseTab_Click"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4C4C4C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>

    <Grid>

        <!-- Шапка -->
        <Border Background="#111111" Height="48" VerticalAlignment="Top">
            <DockPanel Margin="10,0" LastChildFill="False">
                <!-- Левая группа кнопок -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button BorderThickness="0" Background="Transparent">
                        <StackPanel>
                            <Image Source="/Resources/Top-panel/home_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" />
                        </StackPanel>  
                    </Button>
                    <Button Content="Вид" Style="{StaticResource MenuButtonStyle}" />
                    <Button Content="Инструменты" Style="{StaticResource MenuButtonStyle}" />
                </StackPanel>

                <!-- Правая группа кнопок -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Поиск" Style="{StaticResource MenuButtonStyle}" />
                    <Button Content="Меню" Style="{StaticResource MenuButtonStyle}" />
                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Основной контейнер -->
        <Grid Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <StackPanel Grid.Column="0" Width="240" Background="#111111" HorizontalAlignment="Left">
                <!-- Кнопки меню -->
                <StackPanel Margin="0,20,0,0">
                    <Button Content="Отчеты" Style="{StaticResource MenuButtonStyle}" Click="ReportsButton_Click"/>
                    <Button Content="Финансы" Style="{StaticResource MenuButtonStyle}" Click="FinanceButton_Click"/>
                    <Button Content="Адмни-панель" Style="{StaticResource MenuButtonStyle}" Click="AdminButton_Click"/>
                    <!--<Button Content="Пользователи" Style="{StaticResource MenuButtonStyle}" Click="UsersButton_Click"/>-->
                </StackPanel>
                <StackPanel Margin="-10,467,0,0" Orientation="Horizontal">
                    <TextBlock Text="ООО « »" FontSize="20" Foreground="White" Margin="20,30,0,0" />
                    <Button Content="" Style="{StaticResource MenuButtonStyle}" Margin="60,30,0,10" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>

            <!-- Основная область справа с вкладками -->
            <TabControl x:Name="MainTabControl" Grid.Column="1" Background="#1A1A1A" Foreground="White" Margin="10" >
                <!-- Можно добавить начальную вкладку сразу -->
                <TabItem Header="Главная" Margin="-2,0,-2,0" >
                    <Frame Source="Pages/AdminHome.xaml" NavigationUIVisibility="Hidden" Height="689.8" />
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>

</Window>
