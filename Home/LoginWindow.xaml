<Window x:Class="Home.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Home"
        mc:Ignorable="d"
        Title="Атвторизация" 
        Height="800" Width="1200"
        Background="#1A1A1A">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="20,10,20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Стиль для TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="3,3,0,0"
                            BorderThickness="0" 
                            >
                            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                                <ContentPresenter x:Name="ContentSite" 
                                              VerticalAlignment="Center" 
                                              ContentSource="Header" 
                                              Margin="6,0,0,0" 
                                              RecognizesAccessKey="True"/>
                                <Button x:Name="PART_Close"
                                Content="✕"
                                Width="16"
                                Height="16"
                                Margin="5,0,0,0"
                                FontSize="12"
                                FontWeight="Bold"
                                Background="Transparent"
                                Foreground="White"
                                BorderBrush="{x:Null}"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Шапка -->
        <Border Background="#111111" Height="48" VerticalAlignment="Top">
            <DockPanel Margin="10,0" LastChildFill="False">
                <!-- Левая группа кнопок -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="Дом" Style="{StaticResource MenuButtonStyle}" Foreground="#FF7B7777" />
                    <Button Content="Вид" Style="{StaticResource MenuButtonStyle}" Foreground="#FF7B7777" />
                    <Button Content="Инструменты" Style="{StaticResource MenuButtonStyle}" Foreground="#FF7B7777" />
                </StackPanel>

                <!-- Правая группа кнопок -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Поиск" Style="{StaticResource MenuButtonStyle}" Foreground="#FF7B7777" />
                    <Button Content="Меню" Style="{StaticResource MenuButtonStyle}" Foreground="#FF7B7777" />
                </StackPanel>

            </DockPanel>
        </Border>
        <Grid>
            <Border Background="#111111" CornerRadius="10" BorderThickness="2" BorderBrush="Gray" Width="400" Height="420" VerticalAlignment="Center">
                <StackPanel>
                    <Label Margin="0,25,0,0" Foreground="White" HorizontalAlignment="Center" FontSize="36">Авторизация</Label>
                    <StackPanel VerticalAlignment="Center" Margin="0,70,0,25">
                        <Label HorizontalAlignment="Center" Foreground="White" FontSize="20">Логин</Label>
                        <TextBox Foreground="White" x:Name="loginBox" Margin="0,0,0,0" BorderBrush="Gray" BorderThickness="2" Background="#212121" HorizontalAlignment="Center" Width="300" Height="30" FontSize="18" />
                        <Label HorizontalAlignment="Center" Foreground="White" FontSize="20">Пароль</Label>
                        <PasswordBox Foreground="White" x:Name="passwordBox" BorderBrush="Gray" BorderThickness="2" Background="#212121" HorizontalAlignment="Center" Width="300" Height="30" FontSize="18" ></PasswordBox>
                        <Button HorizontalAlignment="Right" Margin="0,80,20,0" FontSize="18" Height="30" Width="150" x:Name="loginBtn" Foreground="White" BorderBrush="Gray" BorderThickness="2" Background="#212121" Click="loginBtn_Click">Войти</Button>
                    </StackPanel>
                    
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
